{
  "expo": {
    "name": "RedactPDF",
    "slug": "redact-pdf",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "redactpdf",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B0C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.princemahlaba.redactpdf",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "RedactPDF needs photo access to import scanned documents for redaction.",
        "NSCameraUsageDescription": "RedactPDF can capture document photos for redaction.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.redactpdf.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "RedactPDF needs photo access to import scanned documents for redaction."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e8f10f30-fabd-4548-b98e-da51679ce2e2"
      }
    }
  }
}
